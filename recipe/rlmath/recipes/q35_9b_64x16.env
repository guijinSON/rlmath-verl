# Fixed recipe: Qwen3.5-9B agentic GRPO, 64 prompts x 16 rollouts per step (2 updates x 512 trajectories).
# The algorithm of every 9B run since 10-17 (JUPITER sf/arxivmath/op-hard, MLXP rm2 v4 + co-hard, KT sf-hard).
# Sourced AFTER the site profile; it sets only algorithm settings. Fixed settings are assigned outright (an exported
# value cannot drift in silently); the OPTIONS below keep a value that is already set.
#
# Options (export before sourcing, or put them in front of the launcher command):
#   LR            set by the lr2e-6 / lr1e-6 recipe files that source this one
#   STALENESS     1.0      async staleness threshold (one 2.0 run so far, co-hard lr1e6 on MLXP, confounded with lr)
#   BACKEND       fsdp     fsdp | megatron (verl Megatron engine, TP=MCORE_TP + sequence parallel; needs the mcore venv)
#   FSDP_OPTIM    torchao_bf16_sr   torchao_bf16_sr | torch_fp32
#   MCORE_OPTIM   bf16     bf16 (precision-aware optimizer: bf16 Adam moments, fp32-exact master via remainders) | fp32
#   MCORE_TP      4
#   TOTAL_STEPS   160      VAL_BEFORE  true
# Per run (always set): EXP, TRAIN_DIR, VAL_DIR, REMOTE_AGENT_TASK_PATH_TEMPLATE="$TRAIN_DIR/{instance_id}"

export MODEL=${MODEL:-Qwen/Qwen3.5-9B}
# batch: TRAIN_BS prompts x ROLLOUT_N per update, REQUIRE_BATCHES updates per step
export TRAIN_BS=32 REQUIRE_BATCHES=2 ROLLOUT_N=16 SYNC_EVERY=1 PARTIAL=true
export TOTAL_STEPS=${TOTAL_STEPS:-160}
# episodes: 12 agent turns, 8k prompt, 131k-token trajectory budget, 32k tokens per model call
export MAX_TURNS=12 MAX_PROMPT=8192 MAX_RESPONSE=131072 TURN_TOKENS=32768
export STALENESS=${STALENESS:-1.0}
# objective: GRPO, no KL, clip 0.2/0.28 (launcher), entropy 0, token-level TIS (threshold 2.0) for the rollout/train mismatch,
# truncated trajectories filtered out of the loss, infra-failed trials dropped from their group, token-in/token-out proxy
export ENTROPY_COEFF=0 OVERLONG_MODE=filter DROP_INFRA_FAILED=true RLMATH_TITO=1 RLMATH_TEXT_ONLY=1
export ROLLOUT_IS=token ROLLOUT_IS_THRESHOLD=2.0
# one sequence per micro-batch (Qwen3.5 GatedDeltaNet must not see packed neighbours)
export DYNAMIC_BSZ=false MICRO_BS=1 FILTER_OVERLONG_PROMPTS=false PARAM_OFFLOAD=false OPTIM_OFFLOAD=false
# validation: T=1.0 / top-p 0.95, one attempt per task, exempt from stop-after-truncation; val + ckpt every 4 steps
export VAL_TEMP=1.0 VAL_TOP_P=0.95 VAL_NO_STOP=1 VAL_BEFORE=${VAL_BEFORE:-true}
export SAVE_FREQ=4 TEST_FREQ=4
export RLMATH_ENV_LIFECYCLE_PER_WORKER=3
# backend + optimizer options
export TRAIN_BACKEND=${BACKEND:-${TRAIN_BACKEND:-fsdp}}
export FSDP_OPTIM=${FSDP_OPTIM:-torchao_bf16_sr} MCORE_OPTIM=${MCORE_OPTIM:-bf16} MCORE_TP=${MCORE_TP:-4}
# trainer GPUs sat at ~68 GB allocated / 91 GB reserved on 96 GB GH200; a Triton autotune in the GDN backward then
# OOMed (arxivmath c5, 10-23) -> expandable segments (vLLM 0.20's cumem allocator toggles it off around its pool)
export PYTORCH_CUDA_ALLOC_CONF=${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}
