# Site: Slurm GH200 cluster (aarch64; e.g. JSC JUPITER) -- for infra/slurm/rlmath.sbatch. 8 nodes: 4 vLLM nodes + 4 trainer nodes.
# TEMPLATE: copy to infra/sites/<name>.env (gitignored in the public repo) and replace the /path/to/... placeholders.
# Layout: code + venvs on $FSCRATCH (read-mostly), data + checkpoints on $SCRATCH, logs/W&B/caches in $HOME.
# the project's quotas: soft limit 8.0M inodes per filesystem (hard 8.8M); above the soft limit new files fail with EDQUOT.
export W=/path/to/fscratch/$USER/rlmath-rl
export VENV=/path/to/fscratch/$USER/agentic/venv-q35
if [ "${BACKEND:-${TRAIN_BACKEND:-fsdp}}" = megatron ]; then export VENV=/path/to/fscratch/$USER/agentic/venv-mcore; fi
export DATA=/path/to/scratch/$USER/agentic                     # $DATA/aav/<set>, $DATA/rm2/...
export CKPT_ROOT=/path/to/scratch/$USER/agentic/ckpt_9b
export SLURM_LOG_DIR=$HOME/rlmath/rlmath_logs
export SANDBOX=apptainer RLMATH_NODE_TRIALS_DIR=/tmp/${USER}_rlmath_trials   # $W/verl/trials -> symlink to it
export GPU_LIST=0,1,2,3 ROLLOUT_NODES=4 ROLLOUT_GPUS_PER_NODE=4 TRAIN_NODES=4 TRAIN_GPUS_PER_NODE=4 ROLLOUT_GPUS=4
export ROLLOUT_MEM=0.65 CKPT_BUCKET_MB=1024 MAX_CONCURRENT_PROMPTS=48 RLMATH_TRIALS_PER_WORKER=48 ALLOW_RESUME=1
export HF_HOME_OVERRIDE=/path/to/scratch/$USER/hf HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
export HF_DATASETS_CACHE=/tmp/${USER}_hfds_${SLURM_JOB_ID:-$$}     # per job: concurrent jobs raced on a shared parquet cache
export WANDB_MODE=offline WANDB_DIR=$HOME/rlmath/rlmath_wandb   # compute nodes are offline; synced from a login node
export WANDB_SYNC_STATE=$HOME/rlmath/wandb_sync_state EXPORT_STATE_DIR=$HOME/rlmath/dl   # infra/slurm/wandb_offline_sync.sh, export_ckpts.sh
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 TMPDIR=/tmp VLLM_USE_FLASHINFER_MOE_FP16=0 VLLM_USE_DEEP_GEMM=0
module load CUDA >/dev/null 2>&1
export PATH=/path/to/fscratch/$USER/agentic/bin:$VENV/bin:$PATH
export FLASHINFER_WORKSPACE_BASE=$HOME/rlmath/flashinfer_ws   # prebuilt GDN prefill kernel
# multi-node: agents reach the proxy over ib0; NCCL/Gloo over InfiniBand
export RLMATH_PROXY_IP_FROM_URL=1 IB_IF=ib0
export NCCL_SOCKET_IFNAME=ib0 GLOO_SOCKET_IFNAME=ib0 NCCL_SOCKET_FAMILY=IPv4 GLOO_SOCKET_FAMILY=IPv4 NCCL_IB_GID_INDEX=3 NCCL_IB_RETRY_CNT=7 NCCL_IB_TIMEOUT=22
if [ "${BACKEND:-${TRAIN_BACKEND:-fsdp}}" = megatron ]; then export RLMATH_LIMITS_FILE=/path/to/fscratch/$USER/jobs/sweep_rm2/limits_64x16_mcore; fi

# runs before Ray starts; non-zero = abort the job cleanly
site_preflight() {
  local SOFT=8000000 used
  for fs in /path/to/fscratch /path/to/scratch; do used=$(df -i $fs | tail -1 | awk '{print $3}'); echo "[$(date)] $fs inodes used $used, headroom to soft limit $((SOFT-used))"; done
  used=$(df -i /path/to/scratch | tail -1 | awk '{print $3}')
  [ $((SOFT-used)) -ge 5000 ] && mkdir -p "$CKPT_ROOT" && touch "$CKPT_ROOT/.wtest_$SLURM_JOB_ID" && rm -f "$CKPT_ROOT/.wtest_$SLURM_JOB_ID" \
    || { echo "ABORT: cannot safely write checkpoints to $CKPT_ROOT (soft-limit headroom $((SOFT-used)) inodes, or write test failed)"; return 1; }
  mkdir -p "$WANDB_DIR"
}
