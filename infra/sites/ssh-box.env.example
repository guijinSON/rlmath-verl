# Site: single SSH box (8x H200 behind an SSH proxy, x86) -- for infra/run_single_node.sh. Sandboxes: Docker on vast.ai VMs.
# TEMPLATE: copy to infra/sites/<name>.env (gitignored in the public repo) and replace the /path/to/... placeholders.
source /path/to/site_env.sh >/dev/null 2>&1; unset PYTHONPATH
export W=/path/to/nfs/rlmath-rl
export VENV=$W/venv-q36
export DATA=$W/data CKPT_ROOT=$W/ckpt LOG_DIR=$W/logs
export MODEL=${MODEL:-/path/to/nfs/hf_cache/hub/models--Qwen--Qwen3.5-9B/snapshots/c202236235762e1c871ad0ccb60c8ee5ba337b9a}
export HF_HOME_OVERRIDE=/path/to/nfs/hf_cache
export GPU_LIST=0,1,2,3,4,5,6,7 ROLLOUT_GPUS=4 ROLLOUT_MEM=0.70   # 0.80 OOMed at weight sync; 0.60 starved KV (10-18)
export SANDBOX=docker DOCKER_API_VERSION=1.49 DOCKER_CONFIG=$W/.docker
export RLMATH_DEFAULT_SOCK=${RLMATH_DEFAULT_SOCK:-/tmp/sbx-docker.sock}
export RLMATH_LIMITS_FILE=$W/rlmath_limits_kt RLMATH_DOCKER_HOSTS_FILE=$W/docker_hosts_kt
export MAX_CONCURRENT_PROMPTS=64 RLMATH_TRIALS_PER_WORKER=18
export FLASHINFER_WORKSPACE_BASE=$W/.fi_cache VLLM_USE_FLASHINFER_MOE_FP16=0 VLLM_USE_DEEP_GEMM=0 TOKENIZERS_PARALLELISM=false
export RAY_NUM_CPUS=48 OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 GOMAXPROCS=4 RAY_num_server_call_thread=4 RAYON_NUM_THREADS=4 \
  RAYON_RS_NUM_CPUS=4 OPENBLAS_NUM_THREADS=4 NUMEXPR_MAX_THREADS=4 ARROW_NUM_THREADS=4 TORCHINDUCTOR_COMPILE_THREADS=1 POLARS_MAX_THREADS=4

site_prelaunch() {
  export WANDB_API_KEY=$(cat ~/.wandb_key)
  [ -s ~/.hf_amphora_token ] && export HF_TOKEN=$(cat ~/.hf_amphora_token)
  for h in $(grep -v "^#" $RLMATH_DOCKER_HOSTS_FILE 2>/dev/null | awk '$2 > 0 {print $1}'); do $W/bin/docker -H $h ps -aq 2>/dev/null | xargs -r $W/bin/docker -H $h rm -f >/dev/null 2>&1; done
  cd $W/verl && if [ -d trials ]; then local T=$W/trials_trash_$(date +%s); mv trials $T && (setsid nohup rm -rf $T > /dev/null 2>&1 < /dev/null &); fi
}
