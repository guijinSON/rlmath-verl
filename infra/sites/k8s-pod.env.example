# Site: Kubernetes reservation pod (6-8x H200, x86) -- for infra/run_single_node.sh. Sandboxes: Docker on vast.ai VMs.
# TEMPLATE: copy to infra/sites/<name>.env (gitignored in the public repo) and replace the /path/to/... placeholders.
export W=/path/to/nvme_cache/rlmath-rl
export VENV=$W/venv-q36
if [ "${BACKEND:-${TRAIN_BACKEND:-fsdp}}" = megatron ]; then export VENV=$W/venv-mcore; fi
export DATA=$W/data CKPT_ROOT=$W/ckpt LOG_DIR=$W/logs
export MODEL=${MODEL:-/path/to/nvme_cache/hf/hub/models--Qwen--Qwen3.5-9B/snapshots/c202236235762e1c871ad0ccb60c8ee5ba337b9a}
export HF_HOME_OVERRIDE=/path/to/nvme_cache/hf
NG=$(nvidia-smi -L | grep -c "^GPU")       # reservations give 6 or 8 GPUs; trainers stay 4 (ckpt world size 4)
export GPU_LIST=$(seq -s, 0 $((NG-1))) ROLLOUT_GPUS=$((NG-4)) ROLLOUT_MEM=0.85
export SANDBOX=docker DOCKER_API_VERSION=1.49 DOCKER_CONFIG=$W/.docker RLMATH_TUNNEL_AUTOSTART=1
export RLMATH_DEFAULT_SOCK=${RLMATH_DEFAULT_SOCK:-/tmp/sbx-docker.sock}
export RLMATH_LIMITS_FILE=$W/rlmath_limits_mlxp RLMATH_DOCKER_HOSTS_FILE=$W/docker_hosts_mlxp
export MAX_CONCURRENT_PROMPTS=null RLMATH_TRIALS_PER_WORKER=56
export FLASHINFER_WORKSPACE_BASE=$W/.fi_cache VLLM_USE_FLASHINFER_MOE_FP16=0 VLLM_USE_DEEP_GEMM=0
export CUDA_HOME=$W/venv-q36/lib/python3.12/site-packages/nvidia/cu13
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 TOKENIZERS_PARALLELISM=false

site_prelaunch() {
  command -v g++ > /dev/null || (apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq gcc g++ libc6-dev > /dev/null 2>&1)   # Triton/flashinfer JIT
  if [ -s $HOME/.wandb_key ]; then export WANDB_API_KEY="$(cat $HOME/.wandb_key)"; else export WANDB_MODE=offline WANDB_DIR=$W/wandb_offline; fi
  $W/bin/docker compose version > /dev/null 2>&1 || { echo "ABORT: docker compose plugin missing"; return 1; }
  # clear stale containers on the sandbox hosts this run owns (weight > 0)
  for h in $(grep -v "^#" $RLMATH_DOCKER_HOSTS_FILE 2>/dev/null | awk '$2 > 0 {print $1}'); do $W/bin/docker -H $h ps -aq 2>/dev/null | xargs -r $W/bin/docker -H $h rm -f >/dev/null 2>&1; done
  rm -rf $W/verl/trials
}
